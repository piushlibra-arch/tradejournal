# ==============================================================================
# MyTradeJournal Frontend — Environment Configuration Template
# Copy this file to `frontend/.env.local` for local development.
# IMPORTANT: Only NEXT_PUBLIC_* variables are exposed to the client-side browser.
# NEVER put private credentials, database URLs, or JWT secrets in this file.
# ==============================================================================

# Backend REST API Base URL
# Local Development: http://localhost:8000
# Production on Render: https://mytradejournal-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Branding
NEXT_PUBLIC_APP_NAME=MyTradeJournal
