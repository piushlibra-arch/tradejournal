# ==============================================================================
# MyTradeJournal — Unified Environment Variable Reference
# Note: Never commit real production secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------

# PostgreSQL Connection String
# On Render: Auto-populated via fromDatabase: { name: mytradejournal-db, property: connectionString }
# Format: postgresql+asyncpg://user:password@hostname:5432/dbname
DATABASE_URL=postgresql+asyncpg://tradejournal:tradejournal_password@localhost:5433/tradejournal
DATABASE_URL_SYNC=postgresql://tradejournal:tradejournal_password@localhost:5433/tradejournal

# JWT Authentication
# On Render: Generated automatically using generateValue: true (256-bit cryptographically secure string)
JWT_SECRET_KEY=replace-with-a-secure-random-32-plus-character-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application & Logging
APP_NAME=MyTradeJournal
ENVIRONMENT=production
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS) & Allowed Origins
# Specify comma-separated HTTPS origins allowed to access the API
CORS_ORIGINS=http://localhost:3000,https://mytradejournal-frontend.onrender.com
FRONTEND_URL=https://mytradejournal-frontend.onrender.com

# Database Migrations on Startup (Optional fallback for single-replica/free tiers)
RUN_MIGRATIONS_ON_START=false

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------

# Public Backend API Base URL (Accessed by client browser and Next.js SSR)
# On Render: Set to the public HTTPS URL of the backend web service
NEXT_PUBLIC_API_URL=https://mytradejournal-backend.onrender.com
NEXT_PUBLIC_APP_NAME=MyTradeJournal
NODE_VERSION=20
