# ==============================================================================
# MyTradeJournal — Unified Root Environment Variable Reference
# Note: Never commit real production credentials or `.env` files into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI & Python 3.11)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=MyTradeJournal
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database Connection Strings (PostgreSQL 16)
# Local development uses Docker Compose on port 5433:
DATABASE_URL=postgresql+asyncpg://tradejournal:tradejournal_dev@localhost:5433/tradejournal
DATABASE_URL_SYNC=postgresql://tradejournal:tradejournal_dev@localhost:5433/tradejournal

# JWT Authentication
# In production, must be at least 32 characters and cannot match dev placeholders.
# Generate locally with: `openssl rand -hex 32`
# On Render: Auto-generated via `generateValue: true`
JWT_SECRET_KEY=replace-with-a-secure-random-32-plus-character-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Allowed Origins
CORS_ORIGINS=http://localhost:3000,https://mytradejournal-frontend.onrender.com
FRONTEND_URL=https://mytradejournal-frontend.onrender.com

# Migrations on Startup
RUN_MIGRATIONS_ON_START=false

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js 16)
# ------------------------------------------------------------------------------
# In client-side code, only variables prefixed with NEXT_PUBLIC_ are bundled.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MyTradeJournal
NODE_VERSION=20
