# ==============================================================================
# MyTradeJournal Backend — Environment Configuration Template
# Copy this file to `backend/.env` for local development.
# IMPORTANT: Never commit your real `.env` file or production secrets to Git.
# ==============================================================================

# Application Environment ('development', 'test', 'production')
# In 'production', strict secret validation is enforced (no default keys or localhost DBs).
ENVIRONMENT=development
APP_NAME=MyTradeJournal
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL Database Connection URL
# Local Docker development default (matches docker-compose.yml on port 5433):
DATABASE_URL=postgresql+asyncpg://tradejournal:tradejournal_dev@localhost:5433/tradejournal
# Synchronous DB URL (auto-derived in production if omitted):
DATABASE_URL_SYNC=postgresql://tradejournal:tradejournal_dev@localhost:5433/tradejournal

# JWT Authentication Secret Key
# Generate a secure 32+ character key: `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
# On Render: Use `generateValue: true` in render.yaml or paste a 64-character random string.
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string-with-high-entropy-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed Cross-Origin Resource Sharing (CORS) Origins
# Comma-separated list of permitted frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Automated Database Migrations on Server Launch
# Set to 'true' in single-container/free tier deployments where preDeployCommand is unavailable
RUN_MIGRATIONS_ON_START=false
